@page
@model ResumesModel

<div class="resumes-page">
    <div class="resumes-heading">
        <div>
            <p class="home-label">
                COLLEGEJOB
            </p>
            <h1>Каталог резюме</h1>
            <p>Знакомься со специалистами и их навыками</p>
        </div>

        <a class="home-button" asp-page="/CreateResume">Создать резюме</a>
    </div>

    <form method="get" class="resume-search-form">
        <div class="search-field">
            <label for="search">Имя кандидата</label>
            <input type="text" id="search" name="search" value="@Model.Search" placeholder="Например, Александр" />
        </div>

        <div class="search-field">
            <label for="specialityFilter">Специальность</label>
            <select name="specialityFilter" id="specialityFilter">
                <option value="">Все специальности</option>
                @foreach (var speciality in Model.Specialities)
                {
                    <option value="@speciality" selected="@(Model.SpecialityFilter == speciality)"> @speciality </option>
                }
            </select>
        </div>

        <div class="search-actions">
            <button type="submit" class="home-button">Найти резюме</button>
            <a asp-page="/Resumes" class="search-reset">Сбросить</a>
        </div>
    </form>

    <p class="resumes-count">
        Всего резюме: @Model.Students.Count
    </p>

    @if (Model.Students.Count == 0)
    {
        <div class="resume-empty">
            <h2>Пока нет резюме :(</h2>
            <p>Стань первым - заполни свою анкету</p>

            <a asp-page="/CreateResume">
                Создать первое резюме
            </a>
        </div>
    }
    else
    {
        <div class="resumes-grid">
            @foreach (var student in Model.Students)
            {
                <article class="resume-card">
                    <p class="resume-speciality">
                        @student.Speciality
                    </p>
                    <h2>@student.Name</h2>
                    <p>@student.Course</p>
                    <div class="resume-details">
                        <p>
                            <strong>Email:</strong>
                            @student.Email
                        </p>
                        <p>
                            <strong>Телефон:</strong>
                            @student.Phone
                        </p>
                        <p>
                            <strong>Технологии:</strong>
                            @(student.Technologies.Length > 0
                            ? string.Join(", ", student.Technologies) : "Не указаны")
                        </p>
                    </div>
                    <a class="resume-details-button" asp-page="/Resume" asp-route-id="@student.Id">
                        Подробнее
                    </a>
                </article>
            }
        </div>
    }
</div>